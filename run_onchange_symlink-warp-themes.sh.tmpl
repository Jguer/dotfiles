#!/bin/bash
# Symlink Warp themes into the directory Warp actually scans on each OS.
#   - Linux: ~/.local/share/warp-terminal/themes/  (chezmoi writes files here directly)
#   - macOS: ~/.warp/themes/                        (Warp's custom-theme dir on macOS)
# The canonical source is ~/.local/share/warp-terminal/themes/ (managed by chezmoi).

{{- if ne .chezmoi.os "darwin" }}
echo "not darwin, skipping warp theme symlinks"
exit 0
{{- end }}

set -eu

src_dir="${HOME}/.local/share/warp-terminal/themes"
dst_dir="${HOME}/.warp/themes"

mkdir -p "${dst_dir}"

for theme in night-owl light-owl; do
    src="${src_dir}/${theme}.yaml"
    dst="${dst_dir}/${theme}.yaml"

    if [[ ! -e "${src}" ]]; then
        echo "source ${src} missing, skipping" >&2
        continue
    fi

    # If the destination already exists and is not a symlink, back it up.
    if [[ -e "${dst}" && ! -L "${dst}" ]]; then
        mv "${dst}" "${dst}.bak.$$"
        echo "backed up existing ${dst} → ${dst}.bak.$$" >&2
    fi

    # Re-create if missing, broken, or changed.
    if [[ ! -L "${dst}" ]] || [[ "$(readlink "${dst}")" != "${src}" ]]; then
        ln -sf "${src}" "${dst}"
        echo "symlinked ${dst} → ${src}"
    fi
done

# Remove symlinks to canonical themes that are no longer managed.
for stale_dst in "${dst_dir}"/*.yaml; do
    [[ -L "${stale_dst}" ]] || continue
    case "$(readlink "${stale_dst}")" in
        "${src_dir}/night-owl.yaml"|"${src_dir}/light-owl.yaml") ;;
        "${src_dir}/"*)
            rm -f "${stale_dst}"
            echo "removed stale symlink ${stale_dst}"
            ;;
    esac
done

# Clean up symlinks from the old (incorrect) macOS destination.
old_dst_dir="${HOME}/Library/Application Support/warp-terminal/themes"
for orphan_dst in "${old_dst_dir}"/*.yaml; do
    [[ -L "${orphan_dst}" ]] || continue
    case "$(readlink "${orphan_dst}")" in
        "${src_dir}/"*)
            rm -f "${orphan_dst}"
            echo "removed orphaned symlink ${orphan_dst}"
            ;;
    esac
done
