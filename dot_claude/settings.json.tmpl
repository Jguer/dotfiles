{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DO_NOT_TRACK": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git describe *)",
      "Bash(git reflog *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git worktree *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo nextest *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo check *)",
      "Bash(cargo run *)",
      "Bash(cargo bench *)",
      "Bash(cargo doc *)",
      "Bash(cargo tree *)",
      "Bash(cargo add *)",
      "Bash(cargo update *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go fmt *)",
      "Bash(go vet *)",
      "Bash(go run *)",
      "Bash(go mod *)",
      "Bash(go list *)",
      "Bash(go doc *)",
      "Bash(go generate *)",
      "Bash(gofmt *)",
      "Bash(goimports *)",
      "Bash(golangci-lint *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npm ls *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(tsc *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(gh *)",
      "Bash(make *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(terraform plan *)",
      "Bash(terraform validate *)",
      "Bash(terraform fmt *)",
      "Bash(terraform init *)",
      "Bash(tk show *)",
      "Bash(tk diff *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker logs *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(uname *)",
      "Bash(date *)",
      "Bash(pwd)",
      "Edit(./**/*.rs)",
      "Edit(./**/*.go)",
      "Edit(./**/*.ts)",
      "Edit(./**/*.tsx)",
      "Edit(./**/*.js)",
      "Edit(./**/*.jsx)",
      "Edit(./**/*.md)",
      "Edit(./**/*.json)",
      "Edit(./**/*.yaml)",
      "Edit(./**/*.yml)",
      "Edit(./**/*.toml)",
      "Edit(./**/*.sql)",
      "Edit(./**/*.css)",
      "Edit(./**/*.scss)",
      "Edit(./**/*.html)",
      "Edit(./**/*.py)",
      "Edit(./**/*.sh)",
      "Edit(./**/*.fish)",
      "Edit(./**/*.proto)",
      "Edit(./**/*.cue)",
      "Edit(./**/*.jsonnet)",
      "Edit(./**/*.libsonnet)",
      "Edit(./**/*.tf)",
      "Edit(./**/Dockerfile)",
      "Edit(./**/Makefile)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf /*)",
      "Bash(terraform destroy *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh issue delete *)",
      "Bash(gh api --method DELETE *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/secrets/**)",
      "Read(**/.env.*)",
      "Read(**/.netrc)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(~/.ssh/**)",
      "Edit(**/.git/config)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git filter-branch *)",
      "Bash(rm -rf *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(curl * | *)",
      "Read(**/.env)",
      "Edit(**/.github/workflows/**)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit *)",
      "Bash(gh gist *)",
      "Bash(gh secret *)",
      "Bash(gh workflow run *)",
      "Bash(gh auth *)",
      "Bash(gh api --method PATCH *)",
      "Bash(gh api --method PUT *)",
      "Bash(gh api --method POST *)",
      "Bash(terraform apply *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl exec *)",
      "Bash(tk apply *)",
      "Bash(docker push *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(cargo publish *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "fallbackModel": [
    "sonnet"
  ],
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "gopls-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "gcx-marketplace": {
      "source": {
        "source": "github",
        "repo": "grafana/gcx"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "npmjs.com",
        "*.npmjs.com",
        "registry.npmjs.org",
        "crates.io",
        "*.crates.io",
        "static.crates.io",
        "*.rust-lang.org",
        "golang.org",
        "*.golang.org",
        "proxy.golang.org",
        "sum.golang.org",
        "pkg.go.dev",
        "docker.io",
        "*.docker.io",
        "ghcr.io",
        "grafana.com",
        "*.grafana.com",
        "grafana.net",
        "*.grafana.net"
      ]
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "fileCheckpointingEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Pushing commits to any remote branch, including force-pushes",
      "Discarding uncommitted work (git reset --hard, git clean, git checkout -- on a dirty tree)",
      "Applying infrastructure changes: terraform apply, kubectl apply/delete, tk apply, flux reconcile",
      "Publishing packages or images: npm/pnpm/yarn/cargo publish, docker push"
    ],
    "hard_deny": [
      "$defaults",
      "Creating a repository, or changing an existing repository's visibility, without the user having explicitly confirmed public vs private first. Default to private.",
      "Creating a public GitHub Gist. Sharing snippets, docs, reports or visualizations should use a private Artifact unless the user explicitly asked for a gist.",
      "Opening a public pull request against grafana/grafana for a change that fixes a security vulnerability. Stop and confirm with the user before pushing or opening the PR.",
      "Sending the user's email address, credentials, tokens, or file contents from ~/.ssh, ~/.aws, ~/.gnupg, .env or any secrets directory to an external service, URL, or request header"
    ],
    "environment": [
      "$defaults",
      "macOS with zsh. Primary languages: Rust, Go, TypeScript. Work spans both public and internal Grafana Labs repositories as well as personal projects.",
      "Local-only git operations are reversible via git reflog and file checkpointing, so they are low risk. Anything that reaches a remote is not."
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/bash-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/format.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "autoUploadSessions": false,
  "disableDeepLinkRegistration": "disable",
  "autoDreamEnabled": false,
  "disableRemoteControl": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": false,
  "isolatePeerMachines": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false
}
