#!/usr/bin/env bash
# On macOS, Cursor reads ~/Library/Application Support/Cursor.
# Chezmoi manages ~/.config/Cursor (Linux path). Symlink the User JSON files
# so the managed copies are what Cursor actually loads.
# Re-runs when managed Cursor User settings change.
# settings: {{ include "private_dot_config/private_Cursor/User/settings.json" | sha256sum }}

{{- if ne .chezmoi.os "darwin" }}
echo "not darwin, skipping cursor config symlink"
exit 0
{{- end }}

set -euo pipefail

src="${HOME}/.config/Cursor/User/settings.json"
dst_dir="${HOME}/Library/Application Support/Cursor/User"
dst="${dst_dir}/settings.json"

mkdir -p "${dst_dir}"

if [[ ! -e "${src}" ]]; then
  echo "source ${src} missing, skipping" >&2
  exit 0
fi

if [[ -L "${dst}" ]] && [[ "$(readlink "${dst}")" == "${src}" ]]; then
  echo "ok ${dst} → ${src}"
  exit 0
fi

if [[ -e "${dst}" && ! -L "${dst}" ]]; then
  mv "${dst}" "${dst}.bak.$$"
  echo "backed up existing ${dst} → ${dst}.bak.$$" >&2
fi

ln -sfn "${src}" "${dst}"
echo "symlinked ${dst} → ${src}"
